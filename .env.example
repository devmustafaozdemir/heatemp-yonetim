# .env.local olarak kopyalayıp doldurun. .env.local git'e eklenmez.

# Supabase proje adresi (ör. https://<proje-ref>.supabase.co) — tarayıcıya gömülür.
NEXT_PUBLIC_SUPABASE_URL=
# Herkese açık anahtar: publishable (sb_publishable_...) veya eski anon anahtarı.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# YALNIZCA SUNUCU: otomatik USD/TRY kurunu kaydetmek için service role / secret anahtarı.
# NEXT_PUBLIC_ öneki OLMAMALIDIR. Boşsa otomatik kur kaydedilmez, yönetici manuel kur girer.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# Yalnızca yerel veritabanı testleri için (npm run test:db).
DATABASE_URL=
