# Supabase proje adresi ve herkese açık (anon / publishable) anahtar — tarayıcıya gömülür.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Yeni anahtar sistemi kullanılıyorsa anon yerine bunu doldurabilirsiniz:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# YALNIZCA SUNUCUDA: otomatik USD/TRY kurunu (TCMB/ECB) kaydetmek için service role
# (veya secret) anahtarı. NEXT_PUBLIC_ öneki OLMAMALIDIR; tarayıcıya gönderilmez.
# Boş bırakılırsa otomatik kur kaydedilmez, yönetici manuel kur girer.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=

# Yalnızca veritabanı testleri için (npm run test:db). Supabase CLI yerel varsayılanı:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
